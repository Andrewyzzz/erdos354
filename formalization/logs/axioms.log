Dyadic354.Certificate.all_templates_correct (t : Dyadic354.Certificate.Template)
  (ht : t ∈ Dyadic354.Certificate.templates) (p q : ℤ) (hqp : q < p) (hpq : p < 2 * q) :
  Dyadic354.Certificate.ChainMeaning t p q
Dyadic354.Certificate.weights_explicit (first second third : Dyadic354.Certificate.Digits) (d K p q : ℤ) :
  Dyadic354.Certificate.weights first second third d K p q =
    ![d * K * p + Dyadic354.Certificate.digit first.1, d * K * q + Dyadic354.Certificate.digit first.2,
      2 * d * K * p + 2 * Dyadic354.Certificate.digit first.1 + Dyadic354.Certificate.digit second.1,
      2 * d * K * q + 2 * Dyadic354.Certificate.digit first.2 + Dyadic354.Certificate.digit second.2,
      4 * d * K * p + 4 * Dyadic354.Certificate.digit first.1 + 2 * Dyadic354.Certificate.digit second.1 +
        Dyadic354.Certificate.digit third.1,
      4 * d * K * q + 4 * Dyadic354.Certificate.digit first.2 + 2 * Dyadic354.Certificate.digit second.2 +
        Dyadic354.Certificate.digit third.2]
def Dyadic354.CyclicGaps.MissingRun : Set ℤ → ℕ → Prop :=
fun S r => ∃ a, ∀ i < r, a + ↑i ∉ S
def Dyadic354.CyclicGaps.gap : {d : ℕ} → [NeZero d] → (X : Finset (ZMod d)) → X.Nonempty → ℕ :=
fun {d} [NeZero d] X hX => Nat.find ⋯
def Dyadic354.Mesh.Consecutive : Finset ℤ → ℤ → ℤ → Prop :=
fun W a b => a ∈ W ∧ b ∈ W ∧ a < b ∧ ∀ w ∈ W, a < w → b ≤ w
def Dyadic354.Mesh.gap : Finset ℤ → ℕ :=
fun W => (W.product W).sup fun ab => if Dyadic354.Mesh.Consecutive W ab.1 ab.2 then (ab.2 - ab.1).toNat else 0
def Dyadic354.Mesh.span : (W : Finset ℤ) → W.Nonempty → ℤ :=
fun W hW => W.max' hW - W.min' hW
def Dyadic354.Mesh.MeshOn : Finset ℤ → ℤ → ℤ → ℕ → Prop :=
fun W lo hi k => Dyadic354.Mesh.Encloses W lo hi ∧ ∀ (z : ℤ), lo ≤ z → z ≤ hi → ∃ w ∈ W, z ≤ w ∧ w < z + ↑k

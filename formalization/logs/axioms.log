def Dyadic354.PartI : Prop :=
∀ (α β : ℝ), 0 < α → 0 < β → Irrational (α / β) → Dyadic354.IndexedComplete (Dyadic354.interleave α β 2)
def Dyadic354.StrongCompleteness : Prop :=
∀ (α β : ℝ), 0 < α → 0 < β → Irrational (α / β) → Dyadic354.SetStronglyComplete (Dyadic354.dyadicValueSet α β)
def Dyadic354.IndexedComplete : (ℕ → ℤ) → Prop :=
fun w => ∀ᶠ (k : ℤ) in Filter.atTop, Dyadic354.IsSubsetSum w k
def Dyadic354.SetStronglyComplete : Set ℤ → Prop :=
fun A => ∀ (B : Set ℤ), B.Finite → Dyadic354.SetComplete (A \ B)
def Dyadic354.interleave : ℝ → ℝ → ℝ → ℕ → ℤ :=
fun a b γ n => if n % 2 = 0 then Dyadic354.floorMultiples a γ (n / 2) else Dyadic354.floorMultiples b γ (n / 2)
def Dyadic354.floorMultiples : ℝ → ℝ → ℕ → ℤ :=
fun a γ n => ⌊γ ^ n * a⌋
def Dyadic354.dyadicValueSet : ℝ → ℝ → Set ℤ :=
fun α β => Set.range (Dyadic354.interleave α β 2) \ {0}
def Dyadic354.SetComplete : Set ℤ → Prop :=
fun A => ∀ᶠ (k : ℤ) in Filter.atTop, ∃ s, ↑s ⊆ A ∧ k = ∑ x ∈ s, x
def Dyadic354.IsSubsetSum.{u_1} : {ι : Type u_1} → (ι → ℤ) → ℤ → Prop :=
fun {ι} w z => ∃ s, z = ∑ i ∈ s, w i
def Dyadic354.Certificate.MathematicallyCorrect : List Dyadic354.Certificate.Template → Prop :=
fun data =>
  ∀ (first second : Dyadic354.Certificate.Digits),
    first ≠ (false, false) →
      ∀ (p q : ℤ),
        0 < q →
          q < p → p < 2 * q → ∃ t ∈ data, t.first = first ∧ t.second = second ∧ Dyadic354.Certificate.ChainMeaning t p q
def Dyadic354.Certificate.ChainMeaning : Dyadic354.Certificate.Template → ℤ → ℤ → Prop :=
fun t p q =>
  0 < t.chain.length ∧
    (∀ (i : Fin t.chain.length),
        Dyadic354.Certificate.NodeMeaning t.first t.second (Dyadic354.Certificate.nodeAt t ↑i) p q) ∧
      (∀ (i : Fin (t.chain.length - 1)),
          (Dyadic354.Certificate.nodeAt t (↑i + 1)).lo.eval p q < (Dyadic354.Certificate.nodeAt t ↑i).hi.eval p q ∧
            (Dyadic354.Certificate.nodeAt t ↑i).lo.eval p q < (Dyadic354.Certificate.nodeAt t (↑i + 1)).hi.eval p q) ∧
        (Dyadic354.Certificate.nodeAt t 0).lo.eval p q ≤ p + 2 * q ∧
          7 * p + 6 * q ≤ (Dyadic354.Certificate.nodeAt t (t.chain.length - 1)).hi.eval p q ∧
            ∀ (z : ℤ),
              p + 2 * q ≤ z →
                z ≤ 7 * p + 6 * q →
                  ∃ i,
                    (Dyadic354.Certificate.nodeAt t ↑i).lo.eval p q ≤ z ∧
                      z ≤ (Dyadic354.Certificate.nodeAt t ↑i).hi.eval p q
def Dyadic354.Certificate.NodeMeaning : Dyadic354.Certificate.Digits →
  Dyadic354.Certificate.Digits → Dyadic354.Certificate.Node → ℤ → ℤ → Prop :=
fun first second n p q =>
  n.mask0 < 16 ∧
    n.mask1 < 16 ∧
      n.thirdMask < 4 ∧
        n.lo.eval p q =
            max ((Dyadic354.Certificate.coefficient n.mask0 n.thirdMask).eval p q)
              ((Dyadic354.Certificate.coefficient n.mask1 n.thirdMask).eval p q) ∧
          n.hi.eval p q =
              min ((Dyadic354.Certificate.coefficient n.mask0 n.thirdMask).eval p q)
                    ((Dyadic354.Certificate.coefficient n.mask1 n.thirdMask).eval p q) +
                  p +
                q ∧
            n.lo.eval p q < n.hi.eval p q ∧
              ∀ (third : Dyadic354.Certificate.Digits),
                ∃ c,
                  0 ≤ c ∧
                    c + 1 ≤ 22 ∧
                      Dyadic354.Certificate.constant first second third n.mask0 n.thirdMask = c ∧
                        Dyadic354.Certificate.constant first second third n.mask1 n.thirdMask = c + 1 ∧
                          ∀ (d K : ℤ),
                            Dyadic354.IsSubsetSum (Dyadic354.Certificate.weights first second third d K p q)
                                (d * K * (Dyadic354.Certificate.coefficient n.mask0 n.thirdMask).eval p q + c) ∧
                              Dyadic354.IsSubsetSum (Dyadic354.Certificate.weights first second third d K p q)
                                (d * K * (Dyadic354.Certificate.coefficient n.mask1 n.thirdMask).eval p q + c + 1)

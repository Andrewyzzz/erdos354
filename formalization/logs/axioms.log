def Dyadic354.FloorSequence.correction : ℝ → ℕ → ℤ :=
fun α n => Dyadic354.FloorSequence.term α (n + 1) - 2 * Dyadic354.FloorSequence.term α n
def Dyadic354.FloorSequence.bit : ℝ → ℕ → Bool :=
fun α n => decide (Dyadic354.FloorSequence.correction α n = 1)
def Dyadic354.ExactBlock.IsEvent : ℝ → ℝ → ℕ → Prop :=
fun α β t => 0 < t ∧ Dyadic354.ExactBlock.digits α β (t - 1) ≠ (false, false)
def Dyadic354.PairReindex.swapAfter : ℕ → ℕ → ℕ :=
fun r j => if j < 2 * r then j else if j % 2 = 0 then j + 1 else j - 1
def Dyadic354.FloorDescent.modulus : ℝ → ℝ → ℕ → ℕ :=
fun α β n => (Dyadic354.FloorSequence.term α n).gcd (Dyadic354.FloorSequence.term β n)
def Dyadic354.FloorDescent.pCoord : ℝ → ℝ → ℕ → ℤ :=
fun α β n => Dyadic354.FloorSequence.term α n / ↑(Dyadic354.FloorDescent.modulus α β n)
def Dyadic354.FloorDescent.qCoord : ℝ → ℝ → ℕ → ℤ :=
fun α β n => Dyadic354.FloorSequence.term β n / ↑(Dyadic354.FloorDescent.modulus α β n)
def Dyadic354.FloorDescent.gapAt : ℝ → (β : ℝ) → (n : ℕ) → 0 < Dyadic354.FloorSequence.term β n → ℕ :=
fun α β n hb =>
  Dyadic354.CyclicGaps.gap
    (Dyadic354.Mesh.residues (Dyadic354.PermanentMesh.prefixSums (Dyadic354.interleave α β 2) (2 * n))
      (Dyadic354.FloorDescent.modulus α β n))
    ⋯

@[reducible] def Dyadic354.Representations.PackedIndex : ℕ → ℕ → Type :=
fun n ℓ => Fin (2 * n) ⊕ Dyadic354.Representations.BlockIndex ℓ ⊕ Fin 6
def Dyadic354.Representations.position : (n ℓ : ℕ) → Dyadic354.Representations.PackedIndex n ℓ → ℕ :=
fun n ℓ x =>
  match x with
  | Sum.inl i => ↑i
  | Sum.inr (Sum.inl (Sum.inl i)) => 2 * n + 2 * ↑i
  | Sum.inr (Sum.inl (Sum.inr i)) => 2 * n + 2 * ↑i + 1
  | Sum.inr (Sum.inr i) => 2 * n + 2 * ℓ + ↑i
def Dyadic354.Representations.packedWeights : (n ℓ : ℕ) →

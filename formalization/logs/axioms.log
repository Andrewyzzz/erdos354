      Dyadic354.Certificate.Digits →
        Dyadic354.Certificate.Digits → ℤ → ℤ → ℤ → Dyadic354.Representations.PackedIndex n ℓ → ℤ :=
fun n ℓ old first second third d p q =>
  Sum.elim old
    (Sum.elim (Dyadic354.Representations.blockWeights ℓ d p q)
      (Dyadic354.Certificate.weights first second third d (2 ^ ℓ) p q))
